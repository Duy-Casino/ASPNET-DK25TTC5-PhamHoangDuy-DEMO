# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Địa chỉ công khai của website (dùng cho link email, QR chứng chỉ, ReturnUrl/IPN thanh toán)
PUBLIC_URL=https://eduviet.example.com
HTTP_PORT=80

# Mật khẩu SA của SQL Server: tối thiểu 8 ký tự, có hoa, thường, số, ký tự đặc biệt
SQL_SA_PASSWORD=

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên (vd: openssl rand -base64 48)
JWT_SECRET=

# Tài khoản Admin đầu tiên (tạo khi khởi động nếu chưa có). Xóa mật khẩu khỏi .env sau lần chạy đầu.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kênh thanh toán thử nghiệm (tự thành công, KHÔNG thu tiền). Chỉ bật cho môi trường demo/staging.
PAYMENT_TEST_MODE=false

# VNPay — sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html ; production: https://pay.vnpay.vn/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo — sandbox: https://test-payment.momo.vn/v2/gateway/api/create ; production: https://payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Cloudinary (để trống → lưu tệp trong volume của container)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (để trống → chỉ ghi log, không gửi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@eduviet.example.com

# true nếu proxy phía trước gửi X-Forwarded-Proto=https
HTTPS_REDIRECT=false
